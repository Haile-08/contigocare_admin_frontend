# karai.health Admin — frontend environment
#
# Vite inlines these at build time, so anything here ships to the browser.
# Nothing secret belongs in this file.

# The API origin. Must be origin-relative or https:// in a production build.
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME="karai.health Admin"

# DevTools expose the whole Redux store, access token included. Never in prod.
VITE_ENABLE_DEVTOOLS=true

# The budget for ordinary API calls. Extraction and analysis do not use it:
# those wait on OCR and on a model, so they carry their own, sized above the
# server's matching ceiling (see ANALYSIS_TIMEOUT_SECONDS in the backend).
VITE_REQUEST_TIMEOUT_MS=30000
