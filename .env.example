# Copy to `.env.local` and adjust. Only VITE_* keys reach the browser bundle —
# never put secrets in this file, everything here is public once built.

# Path the SPA calls. Keep it origin-relative so the dev proxy (and, in
# production, your reverse proxy) handles routing to the API.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies `/api` to. Dev only, not bundled.
VITE_DEV_PROXY_TARGET=http://localhost:8000

VITE_APP_NAME=ContigoCare Admin

# Redux DevTools. Must be false in production builds — it exposes app state.
VITE_ENABLE_DEVTOOLS=true

# Abort API requests after this many milliseconds.
VITE_REQUEST_TIMEOUT_MS=30000

# Where the user token is kept: "session" (tab-scoped, cleared on tab close)
# or "memory" (never persisted; a page reload logs the user out).
VITE_TOKEN_STORAGE=session
